{
  "upstream": "https://github.com/recastnavigation/recastnavigation/archive/refs/tags/v1.6.0.tar.gz",
  "upstream_sha256": "d48ca0121962fa0639502c0f56c4e3ae72f98e55d88727225444f500775c0074",
  "pruning": "Only the four libraries (Recast/, Detour/, DetourCrowd/, DetourTileCache/: Include and Source) with the README and License.txt. Not vendored: DebugUtils (drawing helpers for a debug renderer), the demo (RecastDemo), the tests, the documents, the CMake and pkg-config files.",
  "patches": [
    {
      "path": "patches/0001-trig-through-detour-math-hooks.patch",
      "upstream_commit": null,
      "why": "DetourObstacleAvoidance.cpp (dtRorate2D, sampleVelocityAdaptive) and DetourTileCache.cpp (addBoxObstacle) called the C library's cosf and sinf past Detour's own hooks dtMathCosf and dtMathSinf, so a crowd with obstacle avoidance walked differently per platform; upstream-worthy, not yet upstream."
    },
    {
      "path": "patches/0002-deterministic-math-hooks.patch",
      "upstream_commit": null,
      "why": "Detour's dtMathCosf, dtMathSinf and dtMathAtan2f and Recast's two cosf calls (the walkable slope) use port/DeterministicMath.cpp instead of the platform's libm (cosf, sinf, atan2f differ by an ulp between glibc, macOS, the Windows UCRT and emscripten); wrapper-specific."
    },
    {
      "path": "patches/0003-adaptive-pattern-even-divs.patch",
      "upstream_commit": null,
      "upstream_issue": "https://github.com/recastnavigation/recastnavigation/issues/496",
      "why": "sampleVelocityAdaptive wrote a ring's last direction one slot past the one it counted for an even adaptiveDivs: the crowd sampled an uninitialised direction (different by platform and profile), and at adaptiveDivs 32 with adaptiveRings 4 wrote past the end of its stack array (upstream issues #496, #798, open)."
    }
  ],
