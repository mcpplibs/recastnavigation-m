-			qsort(items+imin, inum, sizeof(BVItem), compareItemX);
+			std::stable_sort(items+imin, items+imin+inum, [](const BVItem& a, const BVItem& b) { return compareItemX(&a, &b) < 0; });
 		}
 		else if (axis == 1)
